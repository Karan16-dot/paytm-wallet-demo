generator client {

    provider  = "prisma-client
    output "../generated/prisma
    }

datasource db {
    provider = "postgresql"

}

model Wallet {
    id String @id @default(cuid())
    userId String @unique
    balance BigInt @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("wallets")
}